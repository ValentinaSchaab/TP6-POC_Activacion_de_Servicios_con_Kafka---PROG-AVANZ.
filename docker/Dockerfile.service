# Imagen para cualquier servicio NestJS del monorepo.
# Contexto de build: la RAÍZ del repo (hace falta para compilar libs/contracts y libs/kafka-toolkit).
FROM node:22-slim
RUN npm install -g pnpm@10
WORKDIR /repo

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY libs ./libs
COPY apps ./apps
RUN pnpm install && pnpm run build:libs

ARG APP
ENV APP=${APP}
RUN pnpm --filter @poc/${APP} build

CMD ["sh", "-c", "node apps/${APP}/dist/main"]
